{
	"name": "@loom-dev/renderer",
	"version": "0.6.3",
	"description": "Framework-agnostic DOM renderer for loom — paints Scene IR plus layout into positioned divs and dispatches pointer input.",
	"keywords": [
		"loom",
		"roblox",
		"renderer",
		"dom",
		"ui"
	],
	"license": "MIT",
	"author": "astra-void",
	"homepage": "https://github.com/astra-void/loom#readme",
	"bugs": "https://github.com/astra-void/loom/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/astra-void/loom.git",
		"directory": "packages/renderer"
	},
	"type": "module",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"types": "./src/index.ts",
	"publishConfig": {
		"access": "public",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@loom-dev/runtime": "workspace:*",
		"@loom-dev/scene": "workspace:*"
	},
	"devDependencies": {
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
